{
  "name": "R",
  "scopeName": "source.r",
  "type": "tree-sitter",
  "parser": "tree-sitter-r",
  "injectionNames": ["r"],
  "fileTypes": ["r", "R", "Rprofile", "Rhistory"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:r-lib/tree-sitter-r#v1.3.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "r.wasm",
    "highlightsQuery": "r-highlights.scm",
    "localsQuery": "r-locals.scm",
    "tagsQuery": "r-tags.scm"
  }
}
